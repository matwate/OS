FROM ubuntu:22.04

# Avoid interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    nasm \
    gcc \
    gcc-multilib \
    binutils \
    make \
    coreutils \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /os

# Convert CRLF→LF (Windows line endings) and run build script
CMD ["bash", "-c", "dos2unix build.sh kernel/*.ld boot/*.asm 2>/dev/null || true; bash build.sh"]
